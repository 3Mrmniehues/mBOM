# mBOM app configuration  --  TEMPLATE / REFERENCE
# ----------------------------------------------------------------------------
# You normally DON'T need to edit this by hand. The app writes your settings to
# a per-user file at:
#
#     %LOCALAPPDATA%\mBOM\config.ini        (e.g. C:\Users\<you>\AppData\Local\mBOM)
#
# using the in-app "Data Location" dialog. That per-user location is deliberate:
# the app folder itself may be a shared, cloud-synced SharePoint library, so
# each person's settings and data must live outside it. This template documents
# the keys in case you want to set them manually.

[paths]

# data_dir -- the folder that holds the SQLite database (app.db). This is your
# actual data. Put it somewhere local and NOT inside the synced app folder.
# A local disk / SSD path is safest for a live database; OneDrive works for
# backup but can conflict if the same database is edited on two PCs at once.
# If unset, the app asks you to choose a folder on first run.
#   data_dir = C:\Users\you\AppData\Local\mBOM\data
#   data_dir = D:\mBOM\data

# export_json -- the flat, spreadsheet-friendly JSON snapshot (refreshed when the
# app starts and stops; query it from Excel / Power Query). The app COMPUTES this
# automatically and writes the line here, so you don't set it by hand: it goes one
# level ABOVE the app folder, into
#     <app parent>\backup data\<app-folder-full-path>\bom-data.json
# (the per-install sub-folder keeps snapshots from different machines/paths apart).
# To send it somewhere else for a single run, set the BOM_EXPORT_PATH environment
# variable instead (it overrides this and is not written back).
#   export_json = C:\Users\you\OneDrive\mBOM\backup data\C_Users_you_...\bom-data.json

# Notes:
#   * Absolute paths are used as-is; this includes mapped drives (Z:\...) and
#     UNC shares (\\server\share\...). Windows backslashes are fine - do not
#     double them.
#   * The target folders are created automatically if they don't exist.
#   * One-off overrides without editing this file: set the BOM_DATA_DIR or
#     BOM_EXPORT_PATH environment variables (they take precedence over the file).
